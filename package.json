{
  "name": "projects-forge",
  "version": "1.0.0",
  "description": "Hierarchical task, project, and folder management in a dedicated side panel for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "clean": "rimraf release",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "copy": "cpx '{main.js,manifest.json,styles.css}' release",
    "release": "npm run clean && npm run build && npm run copy",
    "dev-link": "npm run release && ln -sf $(pwd)/release /Users/andrey_m2/Documents/obsidian/my_data/.obsidian/plugins/obsidian-projects-forge"
  },
  "keywords": [
    "obsidian",
    "tasks",
    "projects",
    "gtd",
    "scrum"
  ],
  "author": "ProjectsForge",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "cpx": "^1.2.1",
    "esbuild": "^0.28.1",
    "obsidian": "latest",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.0"
  }
}
